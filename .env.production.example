# Production environment. Copy to .env.production. Never commit that file.
# Start with DACLIFY_ENV_FILE=.env.production npm run dev
DACLIFY_ENV_FILE=.env.production
NETWORK_ENVIRONMENT=mainnet
DATABASE_URL=postgres://daclify:replace-locally@127.0.0.1:5432/daclify
FRONTEND_ORIGIN=https://replace-with-the-production-origin.example
CHAIN_RPC_URL=https://telos.caleos.io
CHAIN_ID=4667b205c6838ef70ff7988f6e8257e8be0e1284a2f59699054a018f743b1d11
RUNTIME_ACCOUNT=core.we
HUB_ACCOUNT=hub.we
RELAY_ACCOUNT=relay.we
RELAY_PRIVATE_KEY=replace-from-the-deploy-key-file
API_PORT=3008
MODULE_DEPLOYMENTS=[{"id":"decide","account":"decide.we"},{"id":"works","account":"works.we"},{"id":"payroll","account":"payroll.we"}]
# PINATA_JWT=replace-locally
# CONTENT_GATEWAY=https://replace-with-your-gateway.mypinata.cloud
CONTENT_FREE_STORAGE_BYTES=0
# Deploy Telos accounts with: npm run deploy -- production
# Add --confirm only when the dry run is right. DEPLOYER_PRIVATE_KEY must control we.
# DEPLOYER_PRIVATE_KEY=replace-locally
# Card payments. Use a separate restricted key for this environment. Set all three together.
# STRIPE_SECRET_KEY=replace-with-a-restricted-key
# STRIPE_WEBHOOK_SECRET=replace-with-the-webhook-signing-secret
# STRIPE_PRICE_ID=replace-with-the-stripe-price-id
