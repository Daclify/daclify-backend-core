# Deployment ONLY. Copy to .env.deploy.production; keep it Git-ignored, mode 0600.
# Must control the production creator we, configured in tools/deploy/environments/production.json.
# Preview: npm run deploy -- production --set-contract (no transaction sent).
# Sending additionally requires --confirm; production still needs explicit authorization.
# No API/database/provider settings belong here. Never load this file into the API.
# Active account keys are generated separately in .artifacts/deploy/production-keys.json.
DEPLOYER_PRIVATE_KEY=replace-with-the-production-creator-private-key
