# Deployment ONLY. Copy to .env.deploy.testnet; keep it Git-ignored, mode 0600.
# Must control the testnet creator 3boidanimus3, configured in tools/deploy/environments/testnet.json.
# Preview: npm run deploy -- testnet --set-contract (no transaction sent).
# Sending additionally requires --commit; production still needs explicit authorization.
# No API/database/provider settings belong here. Never load this file into the API.
# Active account keys are generated separately in .artifacts/deploy/testnet-keys.json.
DEPLOYER_PRIVATE_KEY=replace-with-the-testnet-creator-private-key
