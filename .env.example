# Configure locally; never commit credentials. No production deployment is implied.
DATABASE_URL=postgres://daclify:replace-locally@127.0.0.1:5432/daclify
FRONTEND_ORIGIN=http://127.0.0.1:5178
CHAIN_RPC_URL=http://127.0.0.1:18888
CHAIN_ID=replace-with-the-verified-chain-id
RUNTIME_ACCOUNT=daclifycore
RELAY_ACCOUNT=replace-with-a-relayer-account
RELAY_PRIVATE_KEY=replace-locally
NETWORK_ENVIRONMENT=local
API_PORT=3008
# Optional bootstrap sponsorship, disabled by default. Configure both together.
# Public factory resource/rate limits still require implementation and qualification.
# BOOTSTRAP_OWNER=replace-locally
# BOOTSTRAP_PRIVATE_KEY=replace-locally
# Pinata upload/list/write credentials remain on the backend.
# PINATA_JWT=replace-locally
# CONTENT_GATEWAY=https://replace-with-your-gateway.mypinata.cloud
# Explicit resource allowance, in stored bytes; default 0 permits no new uploads.
CONTENT_FREE_STORAGE_BYTES=0
# Stripe Checkout. Prefer a restricted key. Set all three together.
# The price id comes from Stripe. Do not put a currency amount here.
# STRIPE_SECRET_KEY=replace-with-a-restricted-key
# STRIPE_WEBHOOK_SECRET=replace-with-the-webhook-signing-secret
# STRIPE_PRICE_ID=replace-with-the-stripe-price-id
