# Develop API configuration. Copy to .env; keep it Git-ignored, mode 0600.
# Start: DACLIFY_ENV_FILE=.env npm run dev
# DACLIFY_ENV_FILE selects the file from the SHELL; do not put it inside this file.
# Deployment key goes ONLY in .env.deploy.develop; the API rejects that key.
# Existing shell variables override file values. Optional sections stay commented.
# This template does not deploy contracts or qualify a production release.

# Database: separate database per environment. Startup applies ordered migrations.
DATABASE_URL=postgres://daclify:replace-locally@127.0.0.1:5432/daclify_develop
# Exact browser origin for CORS and Stripe returns, without a URL path.
# For hosted testnet use your actual HTTPS frontend origin instead of loopback.
FRONTEND_ORIGIN=http://127.0.0.1:5178
# Optional JSON array of additional exact browser origins for CORS and POSTs.
# Add a developer origin to TESTNET only; no wildcard or Origin rewriting.
# FRONTEND_ADDITIONAL_ORIGINS=["https://dev.app.daclify.com:5198"]
# Listener binds to 127.0.0.1; put an HTTPS reverse proxy in front when hosted.
API_PORT=3008
NETWORK_ENVIRONMENT=local

# Native Antelope chain ID, not EVM 40/41. Verify with get_info before use.
CHAIN_RPC_URL=http://127.0.0.1:18888
CHAIN_ID=replace-with-the-fixture-chain-id
RUNTIME_ACCOUNT=daclifycore
HUB_ACCOUNT=daclifyhub
RELAY_ACCOUNT=relay
# Generated active key for this relay in .artifacts/deploy/develop-keys.json.
RELAY_PRIVATE_KEY=replace-with-the-relay-active-private-key

# Only accounts with deployed, matching first-party module hashes belong here.
MODULE_DEPLOYMENTS=[{"id":"decide","account":"decide"},{"id":"works","account":"works"},{"id":"payroll","account":"payroll"}]
# Other supported IDs: grants-rounds and endorsement-admission.
# Develop: install extra contracts on the owned fixture before adding accounts.
# Production: select/deploy extraModules in tools/deploy/environments/production.json.

# DAO creation sponsorship. Both fields together, or neither.
# Use the dedicated runtime/operator active key, NOT the funded creator's key.
# This remains a privileged test operator; production permissions need review.
# BOOTSTRAP_OWNER=daclifycore
# BOOTSTRAP_PRIVATE_KEY=replace-with-the-runtime-operator-active-private-key

# Pinata hosted content. JWT + account ID + HTTPS gateway together, or none.
# Mainnet and testnet MUST use separate Pinata accounts. Keep this ownership ID stable.
# JWT must allow public uploads and listing the uploaded files. Backend only.
# Private DAO content is encrypted before uploading to public IPFS.
# PINATA_JWT=replace-with-your-pinata-jwt
# PINATA_ACCOUNT_ID=your-stable-pinata-account-id
# CONTENT_GATEWAY=https://your-gateway.mypinata.cloud
# Stored-byte allowance per DAO. 0 blocks new hosted uploads.
# Launch free allowance: 100000000 bytes (100 MB decimal). Fund it before enabling.
CONTENT_FREE_STORAGE_BYTES=0

# Stripe: all three fields together, or leave all commented out.
# Local/testnet accept ONLY sk_test_/rk_test_ keys. Prefer a restricted key.
# Webhook: POST /v1/billing/stripe/webhook. Use the secret for THIS destination.
# A CLI listener secret differs from a Dashboard webhook endpoint secret.
# Restart the API after replacing a rotated listener secret.
# STRIPE_SECRET_KEY=replace-with-your-environment-specific-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=replace-with-your-destination-whsec-signing-secret
# Account-service Price, not the DAO setup fee (the contract captures $20/$50).
# STRIPE_PRICE_ID=replace-with-your-stripe-price-id

# Email codes: host + sender required; username/password together if used.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_TLS_MODE=starttls
# SMTP_FROM=signin@your-domain.example
# SMTP_USERNAME=replace-with-your-smtp-username
# SMTP_PASSWORD=replace-with-your-smtp-password
# TLS modes: starttls (normally 587), tls (normally 465), local-plain.
# local-plain is ONLY valid on loopback with NETWORK_ENVIRONMENT=local.
# Testnet needs TLS delivery; a plaintext Mailpit fixture is not sufficient.

# Telegram website OIDC: all three fields together, exact approved callback.
# Testnet/mainnet callbacks must be HTTPS. Local HTTP only on localhost/127.0.0.1.
# TELEGRAM_OIDC_CLIENT_ID=replace-with-numeric-telegram-client-id
# TELEGRAM_OIDC_CLIENT_SECRET=replace-with-your-telegram-client-secret
# TELEGRAM_OIDC_REDIRECT_URI=https://your-api-origin.example/v1/sign-in/telegram/oidc/callback
# Mini App auth requires the bot token; the legacy widget also needs username.
# Bot username has no @. OIDC alone does not require the bot-token fields here.
# TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
# TELEGRAM_BOT_USERNAME=replace-with-your-bot-username

# Google proof verification: both fields together, or neither.
# Current adapter pins a PUBLIC RSA JWK. This is not an OAuth client secret.
# Complete Google browser login/key-rotation qualification remains unfinished.
# GOOGLE_CLIENT_ID=replace-with-your-google-client-id
# GOOGLE_PUBLIC_JWK={"kty":"RSA","kid":"replace-with-public-key-id","n":"replace-with-public-modulus","e":"AQAB"}

# Optional docs assistant. These credentials stay on the backend.
# The generated documentation works without an assistant or a paid AI provider.
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Decisions selects a handbook topic; the chat model writes the reply.
# OPENROUTER_DECISIONS_MODEL=openai/gpt-6-luna-decisions
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# These are the defaults. Set Decisions to typesafe/jev-1.13 to explicitly use Jev.
# Restart the API after changing credentials/models; no frontend credentials.

# Managed accounts are not enabled by adding OPENBAO_* to this file.
# OpenBao is currently a provider-test/custody prototype, not wired into main API.
# See docs/decisions/custody.md and docs/operations/paired-login.md for limits.
# All keys/provider credentials remain outside frontend files and Git.

# API signing audience. Required when the browser calls an API on another origin.
# Use https://api.daclify.com (production) or https://testnet.api.daclify.com (testnet).
# For a local Vite /v1 proxy, use the browser origin (e.g. http://localhost:5178).
# API_PUBLIC_ORIGIN=https://testnet.api.daclify.com

# Central DAO merchant payments. Separate Connect destination and OAuth application.
# STRIPE_SECRET_KEY is the platform key; never give it to independent operators.
# Existing legacy STRIPE_PRICE_ID/STRIPE_WEBHOOK_SECRET are only needed for legacy service billing.
# STRIPE_CONNECT_CLIENT_ID=ca_replace_with_environment_client_id
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_with_connect_destination_secret
# DACLIFY_CONNECT_LIVE_PAYMENTS=false
# OAuth redirect: API_PUBLIC_ORIGIN/v1/payments/stripe/callback
# Connect webhook: API_PUBLIC_ORIGIN/v1/payments/stripe/webhook (events on connected accounts).

# Shared hosting subscriptions. One platform Stripe product; prices are generated from native policy.
# DACLIFY_HOSTING_STRIPE_PRODUCT_ID=prod_replace_with_hosting_product_id
# DACLIFY_HOSTING_WEBHOOK_SECRET=whsec_replace_with_platform_destination_secret
# DACLIFY_HOSTING_LIVE_PAYMENTS=false
# Platform webhook: API_PUBLIC_ORIGIN/v1/hosting/stripe/webhook.
# Listen for checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated/deleted, charge.refunded, charge.dispute.created/closed, refund.updated.

# Independent servers using Daclify Connect instead of platform Stripe credentials.
# Set FRONTEND_ORIGIN to the shared app or your own frontend, and API_PUBLIC_ORIGIN to this server.
# Mutually exclusive with central Connect and hosting provider configuration above.
# Secret JSON value: {"apiOrigin":"https://api.daclify.com","frontendOrigin":"https://app.daclify.com","daos":[{"dao":{"chainId":"CHAIN_ID","contract":"OWN_RUNTIME","daoId":"DAO_ID","interfaceVersion":1},"token":"dcp_PRIVATE_BROKER_TOKEN"}]}
# DACLIFY_CONNECT_OPERATOR=
