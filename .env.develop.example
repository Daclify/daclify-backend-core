# Develop environment. Copy to .env and fill the local values there. Never commit .env.
# Start the API with npm run dev. It loads .env.
DACLIFY_ENV_FILE=.env
NETWORK_ENVIRONMENT=local
DATABASE_URL=postgres://daclify:replace-locally@127.0.0.1:5432/daclify
FRONTEND_ORIGIN=http://127.0.0.1:5178
CHAIN_RPC_URL=http://127.0.0.1:18888
CHAIN_ID=replace-with-the-fixture-chain-id
RUNTIME_ACCOUNT=daclifycore
HUB_ACCOUNT=daclifyhub
RELAY_ACCOUNT=relay
RELAY_PRIVATE_KEY=replace-locally
API_PORT=3008
MODULE_DEPLOYMENTS=[{"id":"decide","account":"decide"},{"id":"works","account":"works"},{"id":"payroll","account":"payroll"}]
# PINATA_JWT=replace-locally
# CONTENT_GATEWAY=https://replace-with-your-gateway.mypinata.cloud
CONTENT_FREE_STORAGE_BYTES=0
# Deploy the local accounts with: npm run deploy -- develop
# Add --commit to create a missing account. DEPLOYER_PRIVATE_KEY must control eosio.
# DEPLOYER_PRIVATE_KEY=replace-locally
# Card payments. Set all three together. Prefer a restricted key.
# STRIPE_SECRET_KEY=replace-with-a-restricted-key
# STRIPE_WEBHOOK_SECRET=replace-with-the-webhook-signing-secret
# STRIPE_PRICE_ID=replace-with-the-stripe-price-id
