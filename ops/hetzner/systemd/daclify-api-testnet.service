[Unit]
Description=Daclify testnet API on loopback port 3028
Requires=daclify-postgres.service
After=daclify-postgres.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=daclify-testnet
Group=daclify-testnet
WorkingDirectory=/data/daclify-api/testnet/current/daclify-backend-core
LoadCredential=api.env:/data/daclify-env/testnet.env
Environment=DACLIFY_ENV_FILE=%d/api.env
Environment=NODE_ENV=production
ExecStartPre=/usr/local/bin/node /data/daclify-api/testnet/current/daclify-backend-core/dist/tools/host/preflight.js testnet
ExecStart=/usr/local/bin/node /data/daclify-api/testnet/current/daclify-backend-core/dist/services/api/src/main.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/data/daclify-api/mainnet
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
