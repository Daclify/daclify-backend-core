[Unit]
Description=Loopback Certbot HTTP challenge webroot
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/lib/daclify-acme
ExecStart=/usr/bin/python3 -m http.server 9080 --bind 127.0.0.1 --directory /var/lib/daclify-acme
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
