# Deployment ONLY. Copy to .env.deploy.develop; keep it Git-ignored, mode 0600.
# Must control the develop creator eosio, configured in tools/deploy/environments/develop.json.
# Preview: npm run deploy -- develop --set-contract (no transaction sent).
# Sending additionally requires --commit; production still needs explicit authorization.
# No API/database/provider settings belong here. Never load this file into the API.
# Active account keys are generated separately in .artifacts/deploy/develop-keys.json.
DEPLOYER_PRIVATE_KEY=replace-with-the-develop-creator-private-key
