# Testnet environment. Copy to .env.testnet. Never commit that file.
# Start with DACLIFY_ENV_FILE=.env.testnet npm run dev
DACLIFY_ENV_FILE=.env.testnet
NETWORK_ENVIRONMENT=testnet
DATABASE_URL=postgres://daclify:replace-locally@127.0.0.1:5432/daclify
FRONTEND_ORIGIN=https://replace-with-the-deployed-frontend-origin.example
CHAIN_RPC_URL=https://testnet.telos.caleos.io
CHAIN_ID=1eaa0824707c8c16bd25145493bf062aecddfeb56c736f6ba6397f3195f33c9f
RUNTIME_ACCOUNT=daclifycore1
HUB_ACCOUNT=daclifyhubv1
RELAY_ACCOUNT=daclifyrelay
RELAY_PRIVATE_KEY=replace-from-the-deploy-key-file
API_PORT=3008
MODULE_DEPLOYMENTS=[{"id":"decide","account":"daclifydecid"},{"id":"works","account":"daclifyworks"},{"id":"payroll","account":"daclifypayr1"},{"id":"grants-rounds","account":"daclifygrant"},{"id":"endorsement-admission","account":"daclifyendor"}]
# PINATA_JWT=replace-locally
# CONTENT_GATEWAY=https://replace-with-your-gateway.mypinata.cloud
CONTENT_FREE_STORAGE_BYTES=0
# Deploy Telos testnet accounts with: npm run deploy -- testnet
# Add --commit only when the dry run is right. The creator 3boidanimus3 must already exist.
# Generated keys are kept in .artifacts/deploy/testnet-keys.json; back up that file privately.
# DEPLOYER_PRIVATE_KEY must control 3boidanimus3. The script creates the ten deployment accounts.
# DEPLOYER_PRIVATE_KEY=replace-locally
# Card payments. Use a separate restricted key for this environment. Set all three together.
# STRIPE_SECRET_KEY=replace-with-a-restricted-key
# STRIPE_WEBHOOK_SECRET=replace-with-the-webhook-signing-secret
# STRIPE_PRICE_ID=replace-with-the-stripe-price-id
